--========================================================--
-- AUTO GUARD
--========================================================--
local Character = nil
local HumanoidRootPart = nil
local Humanoid = nil
local CurrentTarget = nil

local function UpdateCharacter()
	Character = player.Character or player.CharacterAdded:Wait()
	HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
	Humanoid = Character:WaitForChild("Humanoid")
end
player.CharacterAdded:Connect(UpdateCharacter)
if player.Character then
	UpdateCharacter()
end

local function IsHoldingContest()
	local ok, value = pcall(function()
		local charFolder = workspace:FindFirstChild(player.Name)
		if not charFolder then return false end
		local stats = charFolder:FindFirstChild("Stats")
		if not stats then return false end
		local client = stats:FindFirstChild("Client")
		if not client then return false end
		local holding = client:FindFirstChild("HoldingContest")
		if not holding then return false end
		return holding.Value
	end)
	return ok and value == true
end

local function GetClosestPlayerWithBall()
	local closest = nil
	local minDist = math.huge
	if not HumanoidRootPart then return nil end
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player
			and plr.Character
			and plr.Character:FindFirstChild("HumanoidRootPart") then
			local hasBall = plr.Character:FindFirstChild("Ball")
				or plr.Character:FindFirstChild("Basketball")
			if hasBall then
				local dist = (plr.Character.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude
				if dist < minDist then
					minDist = dist
					closest = plr
				end
			end
		end
	end
	return closest
end

RunService.RenderStepped:Connect(function()
	-- Must have the toggle ON + holding contest
	if not Toggles.AutoGuard.Value or not IsHoldingContest() then
		CurrentTarget = nil
		return
	end

	if not Character or not HumanoidRootPart or not Humanoid then return end

	CurrentTarget = GetClosestPlayerWithBall()
	if CurrentTarget
		and CurrentTarget.Character
		and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then

		local targetHRP = CurrentTarget.Character.HumanoidRootPart
		local velocity = targetHRP.AssemblyLinearVelocity

		local predictedPosition = targetHRP.Position + (velocity * (Options.PredictionStuds.Value / 20))
		local forwardVec = targetHRP.CFrame.LookVector
		local idealPosition = predictedPosition + forwardVec * Options.GuardDistance.Value

		local toTarget = predictedPosition - HumanoidRootPart.Position
		local flatToTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
		local currentDist = flatToTarget.Magnitude

		local moveDirection
		if currentDist < Options.MinDistance.Value then
			moveDirection = -flatToTarget
		else
			moveDirection = idealPosition - HumanoidRootPart.Position
			moveDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)
		end

		if moveDirection.Magnitude > 0.4 then
			Humanoid:Move(moveDirection.Unit, false)
		else
			Humanoid:Move(Vector3.zero, false)
		end
	end
end)

player.CharacterAdded:Connect(function()
	CurrentTarget = nil
end)
--========================================================--
-- AUTO BLOCK
--========================================================--
local lastPress = 0

local function getCharacter(plr)
	return plr and plr.Character
end

local function hasShootingEnabled(character)
	if not character then return false end
	local stats = character:FindFirstChild("Stats")
	if not stats then return false end
	local offense = stats:FindFirstChild("Offense")
	if not offense then return false end
	local shooting = offense:FindFirstChild("Shooting")
	if not shooting or not shooting:IsA("BoolValue") then return false end
	return shooting.Value == true
end

local function isWithinRange(char1, char2)
	if not char1 or not char2 then return false end
	local hrp1 = char1:FindFirstChild("HumanoidRootPart")
	local hrp2 = char2:FindFirstChild("HumanoidRootPart")
	if not hrp1 or not hrp2 then return false end
	return (hrp1.Position - hrp2.Position).Magnitude <= Options.AutoBlockDistance.Value
end

local function pressSpace()
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	task.wait(0.05)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

RunService.Heartbeat:Connect(function()
	if not Toggles.AutoBlock.Value then return end

	local now = tick()
	if now - lastPress < Options.AutoBlockDelay.Value then return end

	local myChar = getCharacter(player)
	if not myChar then return end

	for _, character in ipairs(workspace:GetChildren()) do
		if character:IsA("Model") and character ~= myChar then
			if hasShootingEnabled(character) and isWithinRange(myChar, character) then
				lastPress = now
				task.wait(0.1)
				pressSpace()
				break
			end
		end
	end
end)
