local function findAndForce(container, targetValue)
    if not container then return end
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            if obj.Name == "Speed" or obj.Name == "SpeedWithBall" or obj.Name == "Acceleration" then
                pcall(function()
                    obj.Value = targetValue
                end)
            end
        end
    end
    local attrs = {"Speed", "SpeedWithBall", "Acceleration"}
    for _, name in ipairs(attrs) do
        if container:GetAttribute(name) ~= nil then
            pcall(function()
                container:SetAttribute(name, targetValue)
            end)
        end
    end
end
local function forceSpeedValues()
    if not Toggles.SpeedWithBall.Value then return end
    local targetValue = Options.SpeedWithBallAmount.Value
    local character = player.Character
    if character then
        findAndForce(character, targetValue)
        findAndForce(character:FindFirstChild("Humanoid"), targetValue)
        findAndForce(character:FindFirstChild("Stats"), targetValue)
        findAndForce(character:FindFirstChild("PlayerStats"), targetValue)
        findAndForce(character:FindFirstChild("Info"), targetValue)
        findAndForce(player:FindFirstChild("Stats"), targetValue)
        findAndForce(player:FindFirstChild("leaderstats"), targetValue)
    end
    findAndForce(player, targetValue)
end
RunService.Heartbeat:Connect(forceSpeedValues)
player.CharacterAdded:Connect(function()
    task.wait(0.5)
    forceSpeedValues()
end)
