local function makeBuffer(bytes)
    local b = buffer.create(#bytes)
    for i = 1, #bytes do
        buffer.writeu8(b, i - 1, bytes[i])
    end
    return b
end
--========================================================--
-- AUTO PERFECT
--========================================================--
local ARG1 = makeBuffer({ 12, 83, 104, 111, 111, 116, 32, 84, 105, 109, 105, 110, 103 }) -- "Shoot Timing"
local ARG2 = makeBuffer({ 0, 0, 200, 66 }) -- float 100
local ARG3 = makeBuffer({ 4, 68, 111, 119, 110 }) -- "Down"
local function getShootingValue()
    local character = player.Character
    if not character then return nil end
    local stats = character:FindFirstChild("Stats")
    if not stats then return nil end
    local offense = stats:FindFirstChild("Offense")
    if not offense then return nil end
    return offense:FindFirstChild("Shooting")
end
local function getRemote()
    local character = player.Character
    if not character then return nil end
    local remotes = character:FindFirstChild("Remotes")
    if not remotes then return nil end
    return remotes:FindFirstChild("ServerConnection")
end
local shootingConnection = nil
local debounce = false
local function setupAutoPerfect()
    if shootingConnection then
        shootingConnection:Disconnect()
        shootingConnection = nil
    end
    local Shooting = getShootingValue()
    if not Shooting then return end
    local function onShootingChanged()
        if not Toggles.AutoPerfect.Value then return end
        if Shooting.Value == true and not debounce then
            debounce = true
            task.wait(0.34)
            local Event = getRemote()
            if Event then
                Event:FireServer(ARG1, ARG2, ARG3)
            end
            task.wait(0.1)
            debounce = false
        end
    end
    shootingConnection = Shooting.Changed:Connect(onShootingChanged)
    onShootingChanged()
end
if player.Character then
    task.spawn(setupAutoPerfect)
end
player.CharacterAdded:Connect(function()
    task.wait(1)
    setupAutoPerfect()
end)
