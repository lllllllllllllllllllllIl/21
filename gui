-- AUTO BLOCK
--========================================================--
local function fireJumpEvent()
    local character = player.Character
    if not character then return end
    local remotes = character:FindFirstChild("Remotes")
    if not remotes then return end
    local event = remotes:FindFirstChild("ServerConnection")
    if not event then return end
    event:FireServer(
        makeBuffer({ 4, 74, 117, 109, 112 }), -- "Jump"
        makeBuffer({ 136, 120, 65, 54, 230, 99, 87, 55, 66, 248, 5, 53 })
    )
end
local function checkDistance(targetChar)
    local character = player.Character
    if not character or not targetChar or targetChar == character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHRP then return false end
    return (hrp.Position - targetHRP.Position).Magnitude <= 6
end
local function onShootingEnabled(targetChar)
    if not Toggles.AutoBlock.Value then return end
    if checkDistance(targetChar) then
        task.wait(0.1)
        fireJumpEvent()
    end
end
local function setupCharacterForBlock(char)
    if not char or char == player.Character then return end
    local stats = char:FindFirstChild("Stats")
    if not stats then return end
    local offense = stats:FindFirstChild("Offense")
    if not offense then return end
    local shooting = offense:FindFirstChild("Shooting")
    if not shooting or not shooting:IsA("BoolValue") then return end
    shooting.Changed:Connect(function(value)
        if value == true then
            onShootingEnabled(char)
        end
    end)
    if shooting.Value then
        onShootingEnabled(char)
    end
end
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player and plr.Character then
        setupCharacterForBlock(plr.Character)
    end
    plr.CharacterAdded:Connect(setupCharacterForBlock)
end
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(setupCharacterForBlock)
end)
