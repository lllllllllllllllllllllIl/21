local function applyBallMag(obj)
    if not Toggles.BallMag.Value then return end
    if obj.Name == "Basketball" or obj.Name == "Ball" then
        local size = Options.BallMagSize.Value
        obj.Size = Vector3.new(size, size, size)
        obj.Anchored = false
    end
end
workspace.ChildAdded:Connect(function(obj)
    applyBallMag(obj)
end)
local function refreshAllBalls()
    if not Toggles.BallMag.Value then return end
    local size = Options.BallMagSize.Value
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "Basketball" or obj.Name == "Ball" then
            obj.Size = Vector3.new(size, size, size)
            obj.Anchored = false
        end
    end
end
Toggles.BallMag:OnChanged(refreshAllBalls)
Options.BallMagSize:OnChanged(refreshAllBalls)
