-- AUTO GUARD
--========================================================--
local CurrentTarget = nil
local mobileHolding = false
local function setupMobileButton()
    local playerGui = player:WaitForChild("PlayerGui", 5)
    if not playerGui then return end
    local mobileGui = playerGui:FindFirstChild("MobileBasketballControls")
    if not mobileGui then return end
    local frame = mobileGui:FindFirstChild("ControlsFrame")
    if not frame then return end
    local guardButton = frame:FindFirstChild("GuardButton")
    if not guardButton then return end
    guardButton.MouseButton1Down:Connect(function()
        mobileHolding = true
    end)
    guardButton.MouseButton1Up:Connect(function()
        mobileHolding = false
    end)
    guardButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            mobileHolding = true
        end
    end)
    guardButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            mobileHolding = false
        end
    end)
end
setupMobileButton()
local function GetClosestPlayerWithBall()
    local closest = nil
    local minDist = math.huge
    local character = player.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hasBall = plr.Character:FindFirstChild("Ball") or plr.Character:FindFirstChild("Basketball")
            if hasBall then
                local dist = (plr.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = plr
                end
            end
        end
    end
    return closest
end
RunService.RenderStepped:Connect(function()
    -- Master toggle must be ON
    if not Toggles.AutoGuard.Value then
        CurrentTarget = nil
        return
    end
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end
    -- Only run the actual logic while holding G / mobile / LT
    local holdingG = UserInputService:IsKeyDown(Enum.KeyCode.G)
    local holdingTrigger = UserInputService:IsKeyDown(Enum.KeyCode.ButtonL2)
    if not (holdingG or mobileHolding or holdingTrigger) then
        CurrentTarget = nil
        return
    end
    CurrentTarget = GetClosestPlayerWithBall()
    if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetHRP = CurrentTarget.Character.HumanoidRootPart
        local velocity = targetHRP.AssemblyLinearVelocity
        local prediction = Options.PredictionStuds.Value
        local guardDist = Options.GuardDistance.Value
        local minDist = Options.MinDistance.Value
        local predictedPosition = targetHRP.Position + (velocity * (prediction / 20))
        local forwardVec = targetHRP.CFrame.LookVector
        local idealPosition = predictedPosition + forwardVec * guardDist
        local toTarget = predictedPosition - hrp.Position
        local flatToTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
        local currentDist = flatToTarget.Magnitude
        local moveDirection
        if currentDist < minDist then
            moveDirection = -flatToTarget
        else
            moveDirection = idealPosition - hrp.Position
            moveDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)
        end
        if moveDirection.Magnitude > 0.4 then
            humanoid:Move(moveDirection.Unit, false)
        else
            humanoid:Move(Vector3.zero, false)
        end
    end
end)
player.CharacterAdded:Connect(function()
    mobileHolding = false
    CurrentTarget = nil
    task.wait(1)
    setupMobileButton()
end)
